# Environment configuration template
# Copy to .env.local for local development (never commit .env or .env.local)

# PostgreSQL database connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/developer_analytics?schema=public"

# The single GitHub username authorized for historical snapshot collection
GITHUB_TRACKED_USERNAME="JOD-X8"

# Optional GitHub Personal Access Token (for higher rate limits: 5,000 req/hr vs 60 req/hr)
GITHUB_ACCESS_TOKEN=""
